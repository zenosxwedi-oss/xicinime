{
  "expo": {
    "name": "Xicinime",
    "slug": "xicinime-mobile",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "xicinime",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#08080f"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "id.xicinime.app",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "android": {
      "package": "id.xicinime.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#08080f"
      },
      "permissions": [],
      "userInterfaceStyle": "dark",
      "allowBackup": false,
      "versionCode": 3
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "bad0331c-0921-46c0-bfed-382db0fcd4e0"
      }
    },
    "owner": "xick"
  }
}
